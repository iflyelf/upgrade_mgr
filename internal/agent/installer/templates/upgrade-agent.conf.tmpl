# upstart 配置（CentOS6 / 旧 Ubuntu）
description "Upgrade Agent (upgrade_mgr)"

start on runlevel [2345]
stop on runlevel [!2345]

respawn
# CentOS 6 的 upstart 0.6.5 不支持 unlimited；限制为 10 次/5 秒，避免异常重启风暴。
respawn limit 10 5

# 日志由 Agent 自身写入固定文件并自动切割；不要在这里重定向 stderr，
# 否则会与 Agent 的文件日志重复。
exec {{.BinPath}} run --server {{.ServerURL}} --state {{.StatePath}} --log {{.LogPath}} --log-max-mb {{.LogMaxMB}} --log-backups {{.LogBackups}}
